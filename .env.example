# ---------------------------------------------------------------
# NetworkHuddle environment variables
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for links in emails,
# canonical URLs and sitemap.xml.
SITE_URL=https://networkhuddle.com

# Host port the app container is published on (bound to 127.0.0.1 only;
# nginx proxies to it).
APP_PORT=3010

# Postgres password used by docker-compose for the "db" service.
# Use letters and digits only (it is embedded in DATABASE_URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string

# Full connection string. docker-compose builds this for you from
# POSTGRES_PASSWORD; set it yourself only when running outside compose.
# DATABASE_URL=postgres://networkhuddle:PASSWORD@localhost:5432/networkhuddle
# Set to "true" if your Postgres requires SSL (managed DBs). Not needed for compose.
DATABASE_SSL=false
# Max Postgres connections per app process (default 10).
PG_POOL_MAX=10

# First admin account, created on first start if it doesn't exist.
# If the email already exists it is promoted to admin (password is NOT changed).
ADMIN_EMAIL=admin@networkhuddle.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=NetworkHuddle Admin

# Insert the fictional demo events on first start (true/false).
SEED_DEMO_EVENTS=true

# Session cookie "Secure" flag. Defaults to true when SITE_URL starts with https.
# Set to false ONLY for testing over plain http (e.g. by IP before certbot).
# COOKIE_SECURE=true

# Address shown on the membership/contact placeholders and legal pages.
CONTACT_EMAIL=hello@networkhuddle.com

# Legal name of the business that runs the site (data controller), shown on the
# privacy notice and terms, e.g. "Example Trading Ltd". Defaults to "NetworkHuddle".
LEGAL_NAME=NetworkHuddle

# ---- Email (password reset, booking and 1-1 notifications) ----
# Sender address. Must be a verified domain with your provider.
MAIL_FROM=NetworkHuddle <no-reply@networkhuddle.com>

# Option A: Resend (https://resend.com). If set, Resend is used.
RESEND_API_KEY=

# Option B: SMTP. Used if RESEND_API_KEY is empty and SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS)
SMTP_SECURE=false

# If neither Resend nor SMTP is configured, emails (including password
# reset links) are printed to the server log: `docker compose logs app`.
